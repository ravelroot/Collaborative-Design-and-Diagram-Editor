{
  "name": "grafo",
  "version": "1.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "portable": "node scripts/build-web.mjs && node scripts/build-portable.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node --test --test-force-exit tests/js/*.test.js",
    "test:e2e": "node --test --test-force-exit --test-concurrency=1 tests/e2e/*.e2e.mjs",
    "desktop": "npm run portable && node scripts/build-desktop.mjs"
  },
  "dependencies": {
    "pixi.js": "8.6.6",
    "yjs": "13.6.27",
    "y-websocket": "2.1.0",
    "y-protocols": "1.0.6",
    "lib0": "0.2.114"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=22"
  }
}
